root = true

[*.{kt,kts}]
indent_size = 4
max_line_length = off
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Match the code as it is: wildcard-free imports are kept, but the rest of ktlint's opinionated
# "official" style would rewrite most of the project, so start from the lighter IntelliJ style.
ktlint_code_style = intellij_idea
